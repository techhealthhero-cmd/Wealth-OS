# ============================================================================
# WEALTH OS — environment configuration
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` (it is already git-ignored).
# ============================================================================

# --- Client-safe (exposed to the browser bundle; NEXT_PUBLIC_ prefix required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only (NEVER prefix with NEXT_PUBLIC_, never sent to the browser)
# Service role key bypasses Row Level Security. Only used in trusted,
# server-only code paths (e.g. admin scripts, background jobs). Do not use it
# in normal request handlers — use the server/browser clients instead.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider credentials (Day 4 — AI Money Coach). Safe to leave blank;
# getAIProvider() returns null and the chat surface shows a clean
# "not configured" state rather than crashing.
AI_API_KEY=
AI_MODEL=

# Stripe billing credentials (Day 7 — SaaS / Billing). All optional;
# getBillingProvider() returns null and checkout/portal/webhook routes
# return a clear "billing not configured" error rather than crashing.
# If STRIPE_SECRET_KEY is set in production, the other three must be set
# too — see src/config/env.ts's production validation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PLUS=
STRIPE_PRICE_ID_PRO=
