# ============================================================================
# WEALTH OS — environment configuration
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` (it is already git-ignored).
# ============================================================================

# --- Client-safe (exposed to the browser bundle; NEXT_PUBLIC_ prefix required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Which environment this deployment is (staging-isolation audit). Leave
# blank locally and on Vercel — next.config.ts fills it in automatically
# from Vercel's own VERCEL_ENV (Production -> "production", Preview ->
# "staging"). Only set this explicitly to override that default, e.g. to
# force a specific Preview deployment into "production" mode for a one-off
# test. Controls: (1) the visible STAGING badge, (2) which Supabase
# project is active (see NEXT_PUBLIC_STAGING_SUPABASE_* below), (3) a hard
# safety check that refuses to start if this is not "production" but
# STRIPE_SECRET_KEY looks like a live-mode key.
NEXT_PUBLIC_APP_ENV=

# --- Server-only (NEVER prefix with NEXT_PUBLIC_, never sent to the browser)
# Service role key bypasses Row Level Security. Only used in trusted,
# server-only code paths (e.g. admin scripts, background jobs). Do not use it
# in normal request handlers — use the server/browser clients instead.
SUPABASE_SERVICE_ROLE_KEY=

# --- Staging isolation (optional) ---------------------------------------
# A SEPARATE Supabase project for staging/Preview deployments, so staging
# never reads or writes production data. All three optional: when unset,
# staging transparently falls back to the primary NEXT_PUBLIC_SUPABASE_*
# project above (today's behavior). Only used when NEXT_PUBLIC_APP_ENV
# resolves to "staging" (see above) — never read in production.
NEXT_PUBLIC_STAGING_SUPABASE_URL=
NEXT_PUBLIC_STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=

# AI provider credentials (Day 4 — AI Money Coach). Safe to leave blank;
# getAIProvider() returns null and the chat surface shows a clean
# "not configured" state rather than crashing.
AI_API_KEY=
AI_MODEL=

# Stripe billing credentials (Day 7 — SaaS / Billing). All optional;
# getBillingProvider() returns null and checkout/portal/webhook routes
# return a clear "billing not configured" error rather than crashing.
# If STRIPE_SECRET_KEY is set, the other three must be set too — see
# src/config/env.ts's assertProductionConsistency().
#
# SAME variable names for Production and Preview — set DIFFERENT VALUES
# per Vercel environment (Live-mode keys for Production, Test/Sandbox-mode
# keys for Preview). The app hard-refuses to start if NEXT_PUBLIC_APP_ENV
# is not "production" and STRIPE_SECRET_KEY looks like a live key
# (sk_live_...) — this is intentional and cannot be bypassed by config.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PLUS=
STRIPE_PRICE_ID_PRO=
