# ============================================================================
# WEALTH OS — environment configuration
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` (it is already git-ignored).
# ============================================================================

# --- Client-safe (exposed to the browser bundle; NEXT_PUBLIC_ prefix required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only (NEVER prefix with NEXT_PUBLIC_, never sent to the browser)
# Service role key bypasses Row Level Security. Only used in trusted,
# server-only code paths (e.g. admin scripts, background jobs). Do not use it
# in normal request handlers — use the server/browser clients instead.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider credentials for the future AI Coach feature (Step 36 — not
# implemented in Day 1). Safe to leave blank until that phase begins.
AI_API_KEY=
AI_MODEL=
